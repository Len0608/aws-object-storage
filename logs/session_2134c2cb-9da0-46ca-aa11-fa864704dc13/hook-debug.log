   result = {}\n        for k, v in asdict(self).items():\n            if v is not None:\n                # Extract value from Text wrapper\n                result[k] = v.value if isinstance(v, Text) else v\n        return result\n\n    def clear(self):\n        \"\"\"Reset all fields to None.\"\"\"\n        self.object_count = None\n        self.s3_uri = None\n"},"tool_use_id":"toolu_01LcsYoMMpSwTPkmZGD36zgL"}

